# Environment Variables Template
# Copy this file to .env and fill in your values

# ==================== Flask Configuration ====================
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_SECRET_KEY=change-this-to-another-random-64-char-string

# ==================== Database ====================
# Development (SQLite)
SQLALCHEMY_DATABASE_URI=sqlite:///hms.db

# Production (PostgreSQL example)
# SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost:5432/hms_db

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# Production Redis with password
# REDIS_URL=redis://:password@localhost:6379/0

# ==================== Email Configuration ====================
# SMTP server settings for sending emails (reminders, reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@hospital.com
SMTP_STARTTLS=true

# ==================== Application Settings ====================
# Timezone for Celery beat schedule
TZ=Asia/Kolkata

# Flask environment (development or production)
FLASK_ENV=development

# ==================== CORS Settings ====================
# Allowed frontend origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# ==================== Security ====================
# JWT token expiration (in hours)
# JWT_ACCESS_TOKEN_EXPIRES=24

# ==================== Optional: External Services ====================
# Google Chat Webhook (for daily reminders alternative)
# GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# SMS API credentials (if using SMS reminders)
# SMS_API_KEY=your-api-key
# SMS_API_SECRET=your-api-secret

# ==================== Monitoring & Logging ====================
# Sentry DSN for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# ==================== Notes ====================
# 1. Never commit this file to version control
# 2. Use strong, unique keys for SECRET_KEY and JWT_SECRET_KEY
# 3. Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 4. For Gmail SMTP: use App Passwords, not your account password
# 5. For production, use managed Redis (AWS ElastiCache, Azure Cache)
